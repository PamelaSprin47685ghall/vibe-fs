{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "managed-chat-incident-evidence-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "execution", "capacity", "diagnostics", "hostContract", "recovery", "integrity"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "managed-chat-incident-evidence" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "facts", "projection", "status"],
      "properties": {
        "key": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sessionId", "physicalUserMessageId"],
          "properties": {
            "sessionId": { "type": "string", "minLength": 1 },
            "physicalUserMessageId": { "type": "string", "minLength": 1 }
          }
        },
        "facts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "projection": { "type": "array" },
        "status": { "type": "object" }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "reconciliation"],
      "properties": {
        "snapshot": { "type": "object" },
        "reconciliation": { "type": "object" }
      }
    },
    "diagnostics": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "hostContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "supportedVersion", "observedVersions", "publicHooks", "supportedOrder", "terminalEvents", "duplicateDelivery", "acceptedMessageReplayCapability"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "supportedVersion": { "type": "string", "minLength": 1 },
        "observedVersions": { "type": "object" },
        "publicHooks": { "type": "array", "items": { "type": "string" } },
        "supportedOrder": { "type": "array", "items": { "type": "string" } },
        "terminalEvents": { "type": "object" },
        "duplicateDelivery": { "type": "string" },
        "acceptedMessageReplayCapability": { "const": "Absent" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation", "runtime"],
      "properties": {
        "observation": { "type": "object" },
        "runtime": { "type": "object" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
