<?xml version="1.0"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuEmitProject>true</WanxiangshuEmitProject>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.203"/>
    <PackageReference Include="Fable.Core" Version="5.0.0"/>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Provider.fs"/>
    <Compile Include="SignedProvider.fsi"/>
    <Compile Include="SignedProvider.fs"/>
    <Compile Include="Runtime.fs"/>
    <Compile Include="GreenConsumer.fs"/>
    <Compile Include="RedConsumer.fs"/>
    <Compile Include="MergedConsumer.fs"/>
    <Compile Include="LeakyContract.fs"/>
    <Compile Include="LeakyConsumer.fs"/>
    <Compile Include="PrivateConsumer.fs"/>
    <Compile Include="PrivateBindingConsumer.fs"/>
    <Compile Include="SignedGreenConsumer.fs"/>
    <Compile Include="SignedRedConsumer.fs"/>
  </ItemGroup>
</Project>
