@@ -0,0 +1,41 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { spawnSync } from 'node:child_process'
+import { fileURLToPath } from 'node:url'
+
+const entry = fileURLToPath(new URL('../../../dist/sandbox/Sandbox.js', import.meta.url))
+const methods = {
+  constructor: 'constructor() { while (true) {} } next() { return 1; }',
+  getter: 'get next() { while (true) {} }',
+  method: 'next() { while (true) {} }',
+  'return getter': "next() { return Object.defineProperty({}, 'value', { enumerable: true, get() { while (true) {} } }); }",
+  'async method': 'async next() { await Promise.resolve(); while (true) {} }',
+}
+
+for (const [kind, methodsSource] of Object.entries(methods)) {
+  test(`SPEC[sandbox-005] a host-invoked Callable ${kind} remains under its deadline`, () => {
+    const script = `
+      import { Sandbox } from ${JSON.stringify(entry)};
+      const api = { async call(Callable) {
+        await new Promise(resolve => setImmediate(resolve));
+        return await new Callable().next({ step: 0 });
+      } };
+      const handle = Sandbox().run(api, 100, Date.now() + 500,
+        'class JsProgram { constructor(api) { this.api = api; } }',
+        ${JSON.stringify(`class Js extends JsProgram { async run() { class Work { ${methodsSource} } return await this.api.call(Work); } }`)});
+      try {
+        const result = JSON.parse(await handle.programPromise);
+        console.log(JSON.stringify(result));
+        process.exitCode = result.__jsHostFailed === true && result.code === 'PROGRAM_TIMEOUT' ? 0 : 3;
+      } catch (error) {
+        console.log(JSON.stringify({ code: error.code, message: error.message }));
+        process.exitCode = error.code === 'ERR_SCRIPT_EXECUTION_TIMEOUT' ? 0 : 4;
+      }
+    `
+    const child = spawnSync(process.execPath, ['--input-type=module', '-e', script], {
+      encoding: 'utf8', timeout: 2500, killSignal: 'SIGKILL',
+    })
+    assert.equal(child.status, 0, JSON.stringify({ error: child.error?.code, signal: child.signal, stdout: child.stdout, stderr: child.stderr }))
+    assert.equal(child.signal, null, 'the runner must classify the timeout before external cleanup')
+  })
+}
