+++ b/src/sandbox/tests/004.test.mjs
@@ -0,0 +1,58 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { Sandbox } from './support.mjs'
+
+const base = 'class JsProgram { constructor(api) { this.api = api; } }'
+const run = async (api, body) => {
+  const source = `class Js extends JsProgram { async run() { ${body} } }`
+  return JSON.parse(await Sandbox().run(api, 1000, Date.now() + 2000, base, source).programPromise)
+}
+
+test('SPEC[sandbox-004] host method receivers retain their own instance', async () => {
+  const api = { value: 42, read() { return this.value } }
+  assert.deepEqual(await run(api, 'return { value: this.api.read() };'), { value: 42 })
+})
+
+test('SPEC[sandbox-004] a host can construct a program class and await its callbacks', async () => {
+  const observations = []
+  const api = {
+    async call(Callable) {
+      const instance = new Callable()
+      const first = await instance.next({ root: '/fixture', step: 0 })
+      const accepted = await instance.watch({ stdout: 'ready', step: 1 })
+      observations.push(first, accepted)
+      return { first, accepted }
+    },
+  }
+  const result = await run(api, `
+    class Work {
+      async next(input) { return { command: input.root, step: input.step }; }
+      async watch(input) { return input.stdout === 'ready'; }
+    }
+    return await this.api.call(Work);
+  `)
+  assert.deepEqual(result, { first: { command: '/fixture', step: 0 }, accepted: true })
+  assert.deepEqual(observations, [{ command: '/fixture', step: 0 }, true])
+})
+
+test('SPEC[sandbox-004] typed host failures retain the minimum output budget', async () => {
+  const failure = Object.assign(new Error('output budget is too small'), {
+    __jsFailure: { code: 'CALL_OUTPUT_BUDGET_TOO_SMALL', reason: 'output budget is too small', minimumOutputBudgetBytes: 4096 },
+  })
+  const result = await run({ read() { throw failure } }, 'return this.api.read();')
+  assert.deepEqual(result, {
+    __jsHostFailed: true,
+    code: 'CALL_OUTPUT_BUDGET_TOO_SMALL',
+    reason: 'output budget is too small',
+    minimumOutputBudgetBytes: 4096,
+  })
+})
+
+test('SPEC[sandbox-004] the public runner has no unisolated alternate entry', () => {
+  assert.equal('runNaive' in Sandbox(), false)
+})
+
+test('SPEC[sandbox-004] host callback invocation preserves the supplied receiver', async () => {
+  const api = { call(callback) { return callback.call({ value: 41 }, 1) } }
+  assert.deepEqual(await run(api, 'return { value: this.api.call(function (step) { return this.value + step; }) };'), { value: 42 })
+})
