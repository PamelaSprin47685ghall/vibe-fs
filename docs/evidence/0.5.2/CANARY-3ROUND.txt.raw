              ]
            }
          }
        },
        {
          "type": "function",
          "function": {
            "name": "join",
            "description": "Wait for any agent or PTY completion",
            "parameters": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {}
            }
          }
        }
      ],
      "tool_choice": "auto",
      "stream": true,
