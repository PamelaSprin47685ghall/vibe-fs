{
  "name": "wanxiangshu",
  "version": "0.5.3",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/Infrastructure/OpenCode/Plugin/Plugin.js",
  "exports": {
    ".": "./dist/Infrastructure/OpenCode/Plugin/Plugin.js"
  },
  "files": [
    "dist/",
    "resources/"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.12.1",
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "format": "node scripts/pre-commit-formatter.mjs --all",
    "lint": "node scripts/pre-commit-formatter.mjs --all",
    "gate:ssot": "node scripts/spec-check.mjs",
    "gate:architecture": "node scripts/architecture-gate.mjs",
    "gate:shock": "node scripts/shock-audit.mjs",
    "gate:docs": "node scripts/strip-doc-bold.mjs",
    "gate:toml": "node scripts/toml-format.mjs",
    "gate:budget": "node scripts/budget-gate.mjs",
    "gate:surface": "node scripts/surface-inventory.mjs",
    "gate:role-matrix": "node scripts/role-matrix-gate.mjs",
    "gate:static": "npm run gate:layout && npm run gate:ssot && npm run gate:architecture && npm run gate:docs && npm run gate:toml && npm run gate:budget && npm run gate:surface && npm run gate:role-matrix",
    "gate:layout": "node scripts/repository-layout-gate.mjs",
    "build": "node scripts/build.mjs",
    "test": "node tests/unit/runner.mjs",
    "test:unit": "node tests/unit/runner.mjs",
    "test:harness": "node tests/e2e/tests/gate-testkit.mjs",
    "test:e2e": "node scripts/run-canary-staggered.mjs",
    "test:e2e:three": "CANARY_REPEAT=3 node scripts/run-canary-staggered.mjs",
    "check": "npm run gate:static && npm run build && npm test && npm run test:harness",
    "check:release": "npm run check && npm run test:e2e:three && npm pack --dry-run"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.4"
  },
  "dependencies": {
    "@fable-org/fable-library-js": "^2.5.1",
    "bun-pty": "^0.4.8",
    "proper-lockfile": "^4.1.2"
  },
  "overrides": {
    "bun-pty": "$bun-pty"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.17.4",
    "eventsource": "^3.0.7",
    "smol-toml": "1.7.0"
  }
}
