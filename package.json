{
  "name": "wanxiangshu",
  "version": "0.8.4",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/OpenCode/Plugin/Plugin.js",
  "exports": {
    ".": "./dist/OpenCode/Plugin/Plugin.js"
  },
  "imports": {
    "#wanxiangshu-loop-detector-envelope": "./dist/Execution/Session/LoopDetectorEnvelope.js"
  },
  "files": [
    "dist/",
    "resources/"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.12.1",
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "format-build-test": "dotnet tool run fantomas src/Wanxiangshu && node scripts/check.mjs && node scripts/build.mjs && node requirements/verification-system/tests/run.mjs && node requirements/verification-system/tests/integration/run.mjs && node requirements/distribution/tests/integration/package/run.mjs && node scripts/warmup-opencode.mjs && node requirements/verification-system/tests/e2e/entry.test.mjs && npm pack --dry-run",
    "format": "wireit",
    "check": "wireit",
    "owner-dep": "wireit",
    "build": "wireit"
  },
  "wireit": {
    "format": {
      "command": "dotnet tool run fantomas src/Wanxiangshu",
      "files": [
        "src/Wanxiangshu/**/*.fs",
        "src/Wanxiangshu/**/*.fsproj",
        ".config/dotnet-tools.json"
      ],
      "output": []
    },
    "check": {
      "command": "node scripts/check.mjs",
      "files": [
        "scripts/checks/**",
        "scripts/lib/**",
        "src/Wanxiangshu/**",
        "requirements/**",
        "proposals/**",
        "AGENTS.md",
        "package.json"
      ],
      "output": []
    },
    "owner-dep": {
      "command": "node scripts/check.mjs --lane=owner-dep",
      "files": [
        "scripts/checks/**",
        "scripts/lib/**",
        "src/Wanxiangshu/**",
        "package.json"
      ],
      "output": []
    },
    "build": {
      "command": "node scripts/build.mjs",
      "files": [
        "scripts/build.mjs",
        "src/Wanxiangshu/**",
        "package.json"
      ],
      "output": [
        "dist/**"
      ]
    }
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.4"
  },
  "dependencies": {
    "@fable-org/fable-library-js": "^2.5.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bun-pty": "^0.4.10",
    "gpt-tokenizer": "^4.0.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.4.3"
  },
  "overrides": {
    "bun-pty": "$bun-pty"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.18",
    "opencode-ai": "1.18.18",
    "smol-toml": "1.8.0",
    "wireit": "^0.14.13"
  }
}
