{
  "name": "wanxiangshu",
  "version": "0.5.2",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "Wanxiangshu.Next Structured Flow runtime compiled via Fable",
  "main": "./build/next/Infrastructure/OpenCode/Plugin/Plugin.js",
  "exports": {
    ".": {
      "import": "./build/next/Infrastructure/OpenCode/Plugin/Plugin.js",
      "default": "./build/next/Infrastructure/OpenCode/Plugin/Plugin.js"
    }
  },
  "files": [
    "build/next",
    "resources"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "format": "node scripts/pre-commit-formatter.mjs --all",
    "lint": "node scripts/pre-commit-formatter.mjs --all",

    "gate:ssot": "node scripts/ssot-lint.mjs",
    "gate:architecture": "node scripts/architecture-gate.mjs",
    "gate:shock": "node scripts/shock-audit.mjs",
    "gate:docs": "node scripts/strip-doc-bold.mjs",
    "gate:toml": "node scripts/toml-format.mjs",
    "gate:budget": "node scripts/budget-gate.mjs",
    "gate:surface": "node scripts/surface-inventory.mjs",
    "gate:conformance": "node scripts/conformance-gate.mjs --check",
    "gate:role-matrix": "node scripts/role-matrix-gate.mjs",
    "gate:static": "npm run gate:layout && npm run gate:ssot && npm run gate:conformance && npm run gate:architecture && npm run gate:docs && npm run gate:toml && npm run gate:budget && npm run gate:surface && npm run gate:role-matrix",
    "gate:layout": "node scripts/repository-layout-gate.mjs",

    "build": "node scripts/clean-fable-output.mjs build && dotnet fable precompile src/Wanxiangshu.Next/Wanxiangshu.Next.fsproj -o build/next",

    "test": "node tests-mjs/runner.mjs",
    "test:unit": "node tests-mjs/runner.mjs",
    "test:harness": "node testkit/opencode/tests/gate-testkit.mjs",
    "test:e2e": "node scripts/run-canary-staggered.mjs",
    "test:e2e:three": "CANARY_REPEAT=3 node scripts/run-canary-staggered.mjs",

    "check": "npm run gate:static && npm run build && npm test && npm run test:harness",
    "check:release": "npm run check && npm run test:e2e:three && npm pack --dry-run"
  },
  "dependencies": {
    "@fable-org/fable-library-js": "^2.5.1",
    "@modelcontextprotocol/sdk": "^1.10.2",
    "@opencode-ai/plugin": "^1.17.4",
    "bun-pty": "^0.4.8",
    "opencode-pty": "^0.3.4",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "1.7.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "bun-pty": "$bun-pty"
  },
  "devDependencies": {
    "eventsource": "^3.0.7"
  },
  "optionalDependencies": {
    "@kreuzberg/tree-sitter-language-pack": "^1.8.1",
    "es-module-lexer": "^2.1.0",
    "highlight.js": "^11.11.1",
    "tsx": "^4.22.4"
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PamelaSprin47685ghall/vibe-fs.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/PamelaSprin47685ghall/vibe-fs/issues"
  },
  "homepage": "https://github.com/PamelaSprin47685ghall/vibe-fs#readme"
}
