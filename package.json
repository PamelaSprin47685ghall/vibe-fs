{
  "name": "wanxiangshu",
  "version": "0.5.3",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/Infrastructure/OpenCode/Plugin/Plugin.js",
  "exports": {
    ".": "./dist/Infrastructure/OpenCode/Plugin/Plugin.js"
  },
  "files": [
    "dist/",
    "resources/"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.12.1",
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "dotnet tool run fantomas src/Wanxiangshu",
    "format:check": "dotnet tool run fantomas --check src/Wanxiangshu",
    "lint": "npm run format:check && node scripts/check.mjs",
    "test": "node tests/unit/run.mjs",
    "test:unit": "node tests/unit/run.mjs",
    "test:harness": "node tests/integration/harness/run.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:three": "node tests/e2e/run.mjs --repeat 3",
    "check": "npm run lint && npm run build && npm test && npm run test:harness",
    "check:release": "npm run check && npm run test:e2e:three && npm pack --dry-run"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.4"
  },
  "dependencies": {
    "@fable-org/fable-library-js": "^2.5.1",
    "bun-pty": "^0.4.8",
    "proper-lockfile": "^4.1.2"
  },
  "overrides": {
    "bun-pty": "$bun-pty"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.17.4",
    "eventsource": "^3.0.7",
    "smol-toml": "1.7.0"
  }
}
