{
  "name": "wanxiangshu",
  "version": "0.5.0-rc.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "Wanxiangshu.Next Structured Flow runtime compiled via Fable",
  "main": "build/next/OpenCode/Plugin.js",
  "exports": {
    ".": {
      "import": "./build/next/OpenCode/Plugin.js",
      "default": "./build/next/OpenCode/Plugin.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "prepare": "node scripts/setup-git-hooks.mjs",
    "format": "node scripts/pre-commit-formatter.mjs",

    "gate:ssot": "node scripts/ssot-lint.mjs",
    "gate:architecture": "node scripts/architecture-gate.mjs",
    "gate:shock": "node scripts/shock-audit.mjs",
    "gate:docs": "node scripts/strip-doc-bold.mjs",
    "gate:toml": "node scripts/toml-format.mjs",
    "gate:budget": "node scripts/budget-gate.mjs",
    "gate:static": "npm run gate:ssot && npm run gate:architecture && npm run gate:docs && npm run gate:toml && npm run gate:budget",

    "build": "node scripts/clean-fable-output.mjs build/next && dotnet fable precompile next/Wanxiangshu.Next.fsproj -o build/next",
    "postbuild": "node scripts/postbuild.mjs",

    "test:mjs": "node tests-mjs/runner.mjs",
    "test:unit": "npm run test:mjs",

    "test:manager-tools": "node --test testkit/opencode/tests/manager-tool-contract.mjs",
    "test:harness": "node testkit/opencode/tests/gate-testkit.mjs",

    "test:e2e:p0": "CANARY_REPEAT=1 node scripts/run-canary-staggered.mjs",
    "test:e2e:p0:three": "CANARY_REPEAT=3 node scripts/run-canary-staggered.mjs",
    "test:e2e:companion": "node testkit/opencode/tests/companion-canary.mjs",
    "test:e2e:manager-companion": "node testkit/opencode/tests/manager-companion-canary.mjs",
    "test:e2e:reviewer": "node testkit/opencode/tests/reviewer-verdict-canary.mjs",
    "test:e2e:executor": "node testkit/opencode/tests/executor-canary.mjs",

    "test": "npm run gate:static && npm run build && npm run test:unit && npm run test:manager-tools && npm run test:harness && npm run test:e2e:p0",
    "test:release": "npm run gate:static && npm run build && npm run test:unit && npm run test:manager-tools && npm run test:harness && npm run test:e2e:p0:three"
  },
  "dependencies": {
    "@fable-org/fable-library-js": "^2.5.1",
    "@modelcontextprotocol/sdk": "^1.10.2",
    "@opencode-ai/plugin": "^1.17.4",
    "bun-pty": "^0.4.8",
    "opencode-pty": "^0.3.4",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "1.7.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "bun-pty": "$bun-pty"
  },
  "devDependencies": {
    "eventsource": "^3.0.7"
  },
  "optionalDependencies": {
    "@kreuzberg/tree-sitter-language-pack": "^1.8.1",
    "es-module-lexer": "^2.1.0",
    "highlight.js": "^11.11.1",
    "tsx": "^4.22.4"
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PamelaSprin47685ghall/vibe-fs.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/PamelaSprin47685ghall/vibe-fs/issues"
  },
  "homepage": "https://github.com/PamelaSprin47685ghall/vibe-fs#readme"
}
