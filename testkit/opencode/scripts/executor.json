{
  "scenario": "executor",
  "scripts": [
    {
      "id": "inspector-title",
      "lane": {
        "session": "inspector-title",
        "role": "title",
        "turn": 1,
        "requestKind": "title"
      },
      "respond": {
        "type": "title",
        "text": "E2E Test Session"
      },
      "match": {}
    },
    {
      "id": "inspector-executor",
      "lane": {
        "session": "inspector",
        "role": "inspector",
        "turn": 1,
        "requestKind": "chat"
      },
      "match": {
        "requiredTools": [
          "executor"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "executor",
        "args": {
          "command": "node -e \"process.stdout.write('x'.repeat(10000))\"",
          "estimated_output_bytes": 2000,
          "estimated_running_secs": 10,
          "estimated_mem_usage": "medium"
        }
      }
    },
    {
      "id": "executor-map-0",
      "lane": {
        "session": "map-0",
        "role": "executor",
        "turn": 1,
        "requestKind": "chat",
        "parentSession": "inspector"
      },
      "match": {
        "containsText": [
          "Summarize command output chunk"
        ]
      },
      "respond": {
        "type": "text",
        "text": "chunk-0"
      }
    },
    {
      "id": "inspector-final",
      "lane": {
        "session": "inspector",
        "role": "inspector",
        "turn": 2,
        "requestKind": "chat"
      },
      "match": {
        "requiredTools": [
          "executor"
        ]
      },
      "respond": {
        "type": "text",
        "text": "Executor completed with reduced output."
      }
    }
  ],
  "setup": {
    "project": {
      "files": {}
    },
    "strict": true
  },
  "session": {
    "agent": "inspector",
    "bind": [
      "inspector-title",
      "inspector"
    ]
  },
  "prompt": {
    "agent": "inspector",
    "text": "Run a large command via executor and summarize."
  },
  "flow": [
    {
      "wait": "inspector-title"
    },
    {
      "wait": "inspector-executor"
    },
    {
      "wait": "executor-map-0"
    },
    {
      "wait": "inspector-final"
    },
    {
      "awaitTerminal": true,
      "requireAssistantTerminal": true
    },
    {
      "expectSatisfied": true
    }
  ],
  "pass": "Executor canary passed."
}
