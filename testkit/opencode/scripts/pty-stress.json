{
  "scenario": "pty-stress",
  "setup": {
    "project": {
      "files": {
        "AGENTS.md": "PTY stress canary\n"
      }
    },
    "strict": true
  },
  "session": {
    "agent": "manager",
    "bind": [
      "manager-title",
      "manager"
    ]
  },
  "prompt": {
    "agent": "manager",
    "text": "Fork DevOps to exercise the structured PTY DSL only (not executor): create, write, read, TERM, join, then TERM-ignored process + KILL, join, list empty, and return the evidence."
  },
  "flow": [
    {
      "wait": "manager-fork-devops"
    },
    {
      "bindChild": {
        "agent": "devops",
        "aliases": [
          "devops"
        ]
      }
    },
    {
      "wait": "devops-fork-pty"
    },
    {
      "wait": "devops-pty-write"
    },
    {
      "wait": "devops-pty-read"
    },
    {
      "wait": "devops-pty-term"
    },
    {
      "wait": "devops-join-term"
    },
    {
      "wait": "devops-fork-pty2"
    },
    {
      "wait": "devops-pty2-term"
    },
    {
      "wait": "devops-pty2-kill"
    },
    {
      "wait": "devops-join-kill"
    },
    {
      "wait": "devops-list"
    },
    {
      "wait": "devops-final"
    },
    {
      "wait": "manager-join"
    },
    {
      "awaitTerminal": true,
      "requireAssistantTerminal": true
    },
    {
      "expectSatisfied": true
    },
    {
      "assertPtyEcho": true
    }
  ],
  "pass": "PTY stress canary passed: DevOps owns fork-pty; cwd, write/read echo, TERM->Closed, KILL forces exit, no leak.",
  "scripts": [
    {
      "id": "manager-title",
      "lane": {
        "session": "manager-title",
        "role": "title",
        "turn": 1,
        "requestKind": "title"
      },
      "match": {},
      "respond": {
        "type": "title",
        "text": "E2E Test Session"
      }
    },
    {
      "id": "session-blogger",
      "lane": {
        "session": "session-blogger",
        "role": "blogger",
        "turn": 1,
        "requestKind": "chat"
      },
      "match": {
        "userRegex": "You are the blogger of a coding agent session\\. Write one dense paragraph"
      },
      "respond": {
        "type": "text",
        "text": "Session background."
      },
      "neverEnd": true,
      "blocking": false
    },
    {
      "id": "manager-fork-devops",
      "lane": {
        "session": "manager",
        "role": "manager",
        "turn": 1,
        "requestKind": "chat"
      },
      "match": {
        "requiredTools": [
          "fork",
          "join",
          "list"
        ],
        "forbiddenTools": [
          "fork-pty",
          "executor",
          "inspector",
          "read",
          "write",
          "edit"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "fork",
        "args": {
          "agent": "devops",
          "prompt": "Use fork-pty only (not executor): 1) fork-pty agent=\"pty\" with command: echo CWD=$(pwd); exec cat 2) fork-pty the returned ptyId with prompt: ECHO_TEST 3) fork-pty the ptyId with empty prompt to READ 4) fork-pty the ptyId with signal=\"TERM\" 5) join and confirm exit 6) fork-pty agent=\"pty\" with command: trap \"\" TERM; echo TRAPPED; exec tail -f /dev/null 7) fork-pty that ptyId with signal=\"TERM\" 8) fork-pty that ptyId with signal=\"KILL\" 9) join 10) list and confirm no active pty remains. Report cwd, ECHO_TEST, and both joins closed."
        }
      }
    },
    {
      "id": "devops-fork-pty",
      "lane": {
        "session": "devops",
        "role": "devops",
        "turn": 1,
        "requestKind": "chat",
        "parentSession": "manager"
      },
      "match": {
        "requiredTools": [
          "fork-pty",
          "join",
          "list",
          "executor",
          "read",
          "glob",
          "grep",
          "inspector",
          "coder"
        ],
        "forbiddenTools": [
          "fork",
          "write",
          "edit",
          "verdict"
        ],
        "userRegex": "Use fork-pty only"
      },
      "respond": {
        "type": "tool-call",
        "tool": "fork-pty",
        "args": {
          "agent": "pty",
          "prompt": "echo CWD=$(pwd); exec cat"
        }
      }
    },
    {
      "id": "devops-pty-write",
      "lane": {
        "session": "devops",
        "role": "devops",
        "turn": 2,
        "requestKind": "chat",
        "parentSession": "manager"
      },
      "match": {
        "requiredTools": [
          "fork-pty",
          "join",
          "list",
          "executor",
          "read",
          "glob",
          "grep",
          "inspector",
          "coder"
        ],
        "forbiddenTools": [
          "fork",
          "write",
          "edit",
          "verdict"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "fork-pty",
        "argsFrom": "lastPtyId",
        "args": {
          "prompt": "ECHO_TEST"
        }
      }
    },
    {
      "id": "devops-pty-read",
      "lane": {
        "session": "devops",
        "role": "devops",
        "turn": 3,
        "requestKind": "chat",
        "parentSession": "manager"
      },
      "match": {
        "requiredTools": [
          "fork-pty",
          "join",
          "list",
          "executor",
          "read",
          "glob",
          "grep",
          "inspector",
          "coder"
        ],
        "forbiddenTools": [
          "fork",
          "write",
          "edit",
          "verdict"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "fork-pty",
        "argsFrom": "lastPtyId",
        "args": {
          "prompt": ""
        }
      }
    },
    {
      "id": "devops-pty-term",
      "lane": {
        "session": "devops",
        "role": "devops",
        "turn": 4,
        "requestKind": "chat",
        "parentSession": "manager"
      },
      "match": {
        "requiredTools": [
          "fork-pty",
          "join",
          "list",
          "executor",
          "read",
          "glob",
          "grep",
          "inspector",
          "coder"
        ],
        "forbiddenTools": [
          "fork",
          "write",
          "edit",
          "verdict"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "fork-pty",
        "argsFrom": "lastPtyId",
        "args": {
          "signal": "TERM"
        }
      }
    },
    {
      "id": "devops-join-term",
      "lane": {
        "session": "devops",
        "role": "devops",
        "turn": 5,
        "requestKind": "chat",
        "parentSession": "manager"
      },
      "match": {
        "requiredTools": [
          "fork-pty",
          "join",
          "list",
          "executor",
          "read",
          "glob",
          "grep",
          "inspector",
          "coder"
        ],
        "forbiddenTools": [
          "fork",
          "write",
          "edit",
          "verdict"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "join",
        "args": {}
      }
    },
    {
      "id": "devops-fork-pty2",
      "lane": {
        "session": "devops",
        "role": "devops",
        "turn": 6,
        "requestKind": "chat",
        "parentSession": "manager"
      },
      "match": {
        "requiredTools": [
          "fork-pty",
          "join",
          "list",
          "executor",
          "read",
          "glob",
          "grep",
          "inspector",
          "coder"
        ],
        "forbiddenTools": [
          "fork",
          "write",
          "edit",
          "verdict"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "fork-pty",
        "args": {
          "agent": "pty",
          "prompt": "trap \"\" TERM; echo TRAPPED; exec tail -f /dev/null"
        }
      }
    },
    {
      "id": "devops-pty2-term",
      "lane": {
        "session": "devops",
        "role": "devops",
        "turn": 7,
        "requestKind": "chat",
        "parentSession": "manager"
      },
      "match": {
        "requiredTools": [
          "fork-pty",
          "join",
          "list",
          "executor",
          "read",
          "glob",
          "grep",
          "inspector",
          "coder"
        ],
        "forbiddenTools": [
          "fork",
          "write",
          "edit",
          "verdict"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "fork-pty",
        "argsFrom": "lastPtyId",
        "args": {
          "signal": "TERM"
        }
      }
    },
    {
      "id": "devops-pty2-kill",
      "lane": {
        "session": "devops",
        "role": "devops",
        "turn": 8,
        "requestKind": "chat",
        "parentSession": "manager"
      },
      "match": {
        "requiredTools": [
          "fork-pty",
          "join",
          "list",
          "executor",
          "read",
          "glob",
          "grep",
          "inspector",
          "coder"
        ],
        "forbiddenTools": [
          "fork",
          "write",
          "edit",
          "verdict"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "fork-pty",
        "argsFrom": "lastPtyId",
        "args": {
          "signal": "KILL"
        }
      }
    },
    {
      "id": "devops-join-kill",
      "lane": {
        "session": "devops",
        "role": "devops",
        "turn": 9,
        "requestKind": "chat",
        "parentSession": "manager"
      },
      "match": {
        "requiredTools": [
          "fork-pty",
          "join",
          "list",
          "executor",
          "read",
          "glob",
          "grep",
          "inspector",
          "coder"
        ],
        "forbiddenTools": [
          "fork",
          "write",
          "edit",
          "verdict"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "join",
        "args": {}
      }
    },
    {
      "id": "devops-list",
      "lane": {
        "session": "devops",
        "role": "devops",
        "turn": 10,
        "requestKind": "chat",
        "parentSession": "manager"
      },
      "match": {
        "requiredTools": [
          "fork-pty",
          "join",
          "list",
          "executor",
          "read",
          "glob",
          "grep",
          "inspector",
          "coder"
        ],
        "forbiddenTools": [
          "fork",
          "write",
          "edit",
          "verdict"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "list",
        "args": {}
      }
    },
    {
      "id": "devops-final",
      "lane": {
        "session": "devops",
        "role": "devops",
        "turn": 11,
        "requestKind": "chat",
        "parentSession": "manager"
      },
      "match": {
        "requiredTools": [
          "fork-pty",
          "join",
          "list",
          "executor",
          "read",
          "glob",
          "grep",
          "inspector",
          "coder"
        ],
        "forbiddenTools": [
          "fork",
          "write",
          "edit",
          "verdict"
        ]
      },
      "respond": {
        "type": "text",
        "text": "DevOps report: both PTYs closed; ECHO_TEST observed; no active pty remains."
      }
    },
    {
      "id": "manager-join",
      "lane": {
        "session": "manager",
        "role": "manager",
        "turn": 2,
        "requestKind": "chat"
      },
      "match": {
        "requiredTools": [
          "fork",
          "join",
          "list"
        ],
        "forbiddenTools": [
          "fork-pty",
          "executor",
          "inspector",
          "read",
          "write",
          "edit"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "join",
        "args": {}
      }
    },
    {
      "id": "manager-final",
      "lane": {
        "session": "manager",
        "role": "manager",
        "turn": 3,
        "requestKind": "chat"
      },
      "match": {
        "requiredTools": [
          "fork",
          "join",
          "list"
        ],
        "forbiddenTools": [
          "fork-pty",
          "executor"
        ]
      },
      "respond": {
        "type": "text",
        "text": "Manager finished: DevOps completed PTY stress with both joins closed and no active pty."
      }
    }
  ]
}
