{
  "scenario": "orchestrator",
  "scripts": [
    {
      "id": "orchestrator-title",
      "lane": {
        "session": "orchestrator-title",
        "role": "title",
        "turn": 1,
        "requestKind": "title"
      },
      "respond": {
        "type": "title",
        "text": "E2E Test Session"
      },
      "match": {}
    },
    {
      "id": "orchestrator-fork-manager",
      "lane": {
        "session": "fast-orchestrator",
        "role": "orchestrator",
        "turn": 1
      },
      "match": {
        "requiredTools": [
          "fork-manager",
          "join"
        ],
        "forbiddenTools": [
          "read",
          "write",
          "edit",
          "bash",
          "glob",
          "grep",
          "verdict",
          "list"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "fork-manager",
        "args": {
          "prompt": "Ship role_surface_proof.txt to the target branch.",
          "agent": "fast-manager"
        }
      }
    },
    {
      "id": "orchestrator-join-result",
      "lane": {
        "session": "fast-orchestrator",
        "role": "orchestrator",
        "turn": 2
      },
      "match": {
        "requiredTools": [
          "fork-manager",
          "join"
        ],
        "forbiddenTools": [
          "list"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "join",
        "args": {}
      }
    },
    {
      "id": "orchestrator-published",
      "lane": {
        "session": "fast-orchestrator",
        "role": "orchestrator",
        "turn": 3
      },
      "match": {
        "user": "Ship publish_proof.txt to the target branch.",
        "requiredTools": [
          "fork-manager",
          "join"
        ],
        "forbiddenTools": [
          "list"
        ]
      },
      "respond": {
        "type": "text",
        "text": "Orchestrator joined the Manager child."
      }
    },
    {
      "id": "manager-fork-coder",
      "lane": {
        "session": "fast-manager",
        "role": "manager",
        "turn": 1,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "match": {
        "requiredTools": [
          "fork",
          "join",
          "list"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "fork",
        "args": {
          "agent": "fast-coder",
          "prompt": "Write role_surface_proof.txt."
        }
      }
    },
    {
      "id": "manager-join-coder",
      "lane": {
        "session": "fast-manager",
        "role": "manager",
        "turn": 2,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "match": {
        "requiredTools": [
          "fork",
          "join",
          "list"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "join",
        "args": {}
      }
    },
    {
      "id": "manager-guard-fork-reviewer",
      "lane": {
        "session": "fast-manager",
        "role": "manager",
        "turn": 3,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "match": {
        "requiredTools": [
          "fork",
          "join",
          "list"
        ],
        "user": "Review is required before completion. Fork or nudge a Reviewer until the current Git tree has two distinct PERFECT verdicts."
      },
      "respond": {
        "type": "tool-call",
        "tool": "fork",
        "args": {
          "agent": "fast-reviewer",
          "prompt": "Review the current worktree for correctness"
        }
      }
    },
    {
      "id": "manager-join-reviewer",
      "lane": {
        "session": "fast-manager",
        "role": "manager",
        "turn": 4,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "match": {
        "requiredTools": [
          "fork",
          "join",
          "list"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "join",
        "args": {}
      }
    },
    {
      "id": "manager-terminal",
      "lane": {
        "session": "fast-manager",
        "role": "manager",
        "turn": 5,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "match": {
        "requiredTools": [
          "fork",
          "join",
          "list"
        ]
      },
      "respond": {
        "type": "text",
        "text": "Manager finished."
      }
    },
    {
      "id": "coder-write",
      "lane": {
        "session": "fast-coder",
        "role": "coder",
        "turn": 1,
        "requestKind": "chat",
        "parentSession": "manager"
      },
      "match": {
        "requiredTools": [
          "write"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "write",
        "args": {
          "filePath": "role_surface_proof.txt",
          "content": "Role surface canary\n"
        }
      }
    },
    {
      "id": "coder-terminal",
      "lane": {
        "session": "fast-coder",
        "role": "coder",
        "turn": 2,
        "requestKind": "chat",
        "parentSession": "manager"
      },
      "match": {
        "requiredTools": [
          "write"
        ]
      },
      "respond": {
        "type": "text",
        "text": "Coder finished."
      }
    },
    {
      "id": "session-blogger",
      "lane": {
        "session": "session-blogger",
        "role": "blogger",
        "turn": 1
      },
      "blocking": false,
      "neverEnd": true,
      "match": {
        "userRegex": "You are the blogger of a coding agent session\\. Write one dense paragraph"
      },
      "respond": {
        "type": "text",
        "text": "Session background."
      }
    },
    {
      "id": "reviewer-after-tool-text",
      "lane": {
        "session": "reviewer-sidecar",
        "role": "reviewer",
        "turn": 1,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "pathless": true,
      "reusable": true,
      "blocking": false,
      "neverEnd": false,
      "match": {
        "requiredTools": [
          "verdict"
        ],
        "afterToolResult": true
      },
      "respond": {
        "type": "text",
        "text": "Reviewer intermediate text after verdict tool."
      }
    },
    {
      "id": "reviewer-perfect-1",
      "lane": {
        "session": "fast-reviewer",
        "role": "reviewer",
        "turn": 1,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "reusable": true,
      "match": {
        "requiredTools": [
          "verdict"
        ],
        "user": "Review the current worktree for correctness",
        "afterToolResult": false
      },
      "respond": {
        "type": "tool-call",
        "tool": "verdict",
        "args": {
          "verdict": "PERFECT"
        }
      }
    },
    {
      "id": "reviewer-perfect-2",
      "lane": {
        "session": "fast-reviewer",
        "role": "reviewer",
        "turn": 2,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "reusable": true,
      "match": {
        "requiredTools": [
          "verdict"
        ],
        "afterToolResult": false,
        "userRegex": "Nope, let's re-evaluate:"
      },
      "respond": {
        "type": "tool-call",
        "tool": "verdict",
        "args": {
          "verdict": "PERFECT"
        }
      }
    },
    {
      "id": "reviewer-perfect-3",
      "lane": {
        "session": "fast-reviewer",
        "role": "reviewer",
        "turn": 1,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "reusable": true,
      "match": {
        "requiredTools": [
          "verdict"
        ],
        "user": "Review the current worktree for correctness",
        "afterToolResult": false
      },
      "respond": {
        "type": "tool-call",
        "tool": "verdict",
        "args": {
          "verdict": "PERFECT"
        }
      }
    },
    {
      "id": "reviewer-perfect-4",
      "lane": {
        "session": "fast-reviewer",
        "role": "reviewer",
        "turn": 2,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "reusable": true,
      "match": {
        "requiredTools": [
          "verdict"
        ],
        "afterToolResult": false,
        "userRegex": "Nope, let's re-evaluate:"
      },
      "respond": {
        "type": "tool-call",
        "tool": "verdict",
        "args": {
          "verdict": "PERFECT"
        }
      }
    },
    {
      "id": "reviewer-perfect-5",
      "lane": {
        "session": "fast-reviewer",
        "role": "reviewer",
        "turn": 1,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "reusable": true,
      "match": {
        "requiredTools": [
          "verdict"
        ],
        "user": "Review the current worktree for correctness",
        "afterToolResult": false
      },
      "respond": {
        "type": "tool-call",
        "tool": "verdict",
        "args": {
          "verdict": "PERFECT"
        }
      }
    },
    {
      "id": "reviewer-perfect-6",
      "lane": {
        "session": "fast-reviewer",
        "role": "reviewer",
        "turn": 2,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "reusable": true,
      "match": {
        "requiredTools": [
          "verdict"
        ],
        "afterToolResult": false,
        "userRegex": "Nope, let's re-evaluate:"
      },
      "respond": {
        "type": "tool-call",
        "tool": "verdict",
        "args": {
          "verdict": "PERFECT"
        }
      }
    },
    {
      "id": "reviewer-perfect-7",
      "lane": {
        "session": "fast-reviewer",
        "role": "reviewer",
        "turn": 1,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "reusable": true,
      "match": {
        "requiredTools": [
          "verdict"
        ],
        "user": "Review the current worktree for correctness",
        "afterToolResult": false
      },
      "respond": {
        "type": "tool-call",
        "tool": "verdict",
        "args": {
          "verdict": "PERFECT"
        }
      }
    },
    {
      "id": "reviewer-perfect-8",
      "lane": {
        "session": "fast-reviewer",
        "role": "reviewer",
        "turn": 2,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "reusable": true,
      "match": {
        "requiredTools": [
          "verdict"
        ],
        "afterToolResult": false,
        "userRegex": "Nope, let's re-evaluate:"
      },
      "respond": {
        "type": "tool-call",
        "tool": "verdict",
        "args": {
          "verdict": "PERFECT"
        }
      }
    }
  ],
  "setup": {
    "project": {
      "files": {
        "AGENTS.md": "- orchestrator role-surface canary\n",
        "README.md": "# orchestrator-canary project\n"
      }
    },
    "strict": true
  },
  "session": {
    "agent": "fast-orchestrator",
    "bind": [
      "orchestrator-title",
      "fast-orchestrator"
    ]
  },
  "prompt": {
    "agent": "fast-orchestrator",
    "text": "Ship role_surface_proof.txt to the target branch."
  },
  "flow": [
    {
      "wait": "orchestrator-fork-manager"
    },
    {
      "wait": "manager-fork-coder"
    },
    {
      "wait": "coder-write"
    },
    {
      "wait": "coder-terminal"
    },
    {
      "wait": "manager-terminal"
    },
    {
      "wait": "reviewer-perfect-1"
    },
    {
      "wait": "reviewer-after-tool-text"
    },
    {
      "wait": "reviewer-perfect-2"
    },
    {
      "wait": "reviewer-after-tool-text"
    },
    {
      "waitFact": {
        "name": "OrchestratorPreRebaseReviewConfirmed",
        "eq": 1
      }
    },
    {
      "wait": "reviewer-perfect-3"
    },
    {
      "wait": "reviewer-after-tool-text"
    },
    {
      "wait": "reviewer-perfect-4"
    },
    {
      "wait": "reviewer-after-tool-text"
    },
    {
      "waitFact": {
        "name": "OrchestratorPostRebaseReviewConfirmed",
        "eq": 1
      }
    },
    {
      "waitFact": {
        "name": "OrchestratorPublished",
        "eq": 1
      }
    },
    {
      "wait": "orchestrator-published"
    },
    {
      "awaitTerminal": true,
      "requireAssistantTerminal": true
    },
    {
      "expectSatisfied": true
    }
  ],
  "pass": "Orchestrator tool-surface canary passed."
}
