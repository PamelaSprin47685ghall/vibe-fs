{
  "scenario": "orch-restart-publish",
  "scripts": [
    {
      "id": "manager-recovery-fork-coder",
      "lane": {
        "session": "fast-manager",
        "role": "manager",
        "turn": 4,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "match": {
        "requiredTools": [
          "fork",
          "join",
          "list"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "fork",
        "args": {
          "agent": "fast-coder",
          "prompt": "Write publish_proof.txt."
        }
      }
    },
    {
      "id": "manager-recovery-join-coder",
      "lane": {
        "session": "fast-manager",
        "role": "manager",
        "turn": 5,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "match": {
        "requiredTools": [
          "fork",
          "join",
          "list"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "join",
        "args": {}
      }
    },
    {
      "id": "manager-recovery-terminal",
      "lane": {
        "session": "fast-manager",
        "role": "manager",
        "turn": 6,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "match": {
        "requiredTools": [
          "fork",
          "join",
          "list"
        ]
      },
      "respond": {
        "type": "text",
        "text": "Manager recovered."
      }
    },
    {
      "id": "coder-recovery-write",
      "lane": {
        "session": "fast-coder",
        "role": "coder",
        "turn": 3,
        "requestKind": "chat",
        "parentSession": "manager"
      },
      "match": {
        "requiredTools": [
          "write"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "write",
        "args": {
          "filePath": "publish_proof.txt",
          "content": "Published by orchestrator canary\n"
        }
      }
    },
    {
      "id": "coder-recovery-terminal",
      "lane": {
        "session": "fast-coder",
        "role": "coder",
        "turn": 4,
        "requestKind": "chat",
        "parentSession": "manager"
      },
      "match": {},
      "respond": {
        "type": "text",
        "text": "Coder recovered."
      }
    }
  ]
}
