{
  "scenario": "manager-full-loop",
  "setup": {
    "project": {
      "files": {
        "AGENTS.md": "manager full loop canary\n",
        "src/main.txt": "target\n"
      }
    },
    "strict": true
  },
  "session": {
    "agent": "fast-manager",
    "bind": [
      "manager-title",
      "fast-manager"
    ]
  },
  "prompt": {
    "agent": "fast-manager",
    "text": "Run full manager loop: fork inspector, browser, meditator in parallel, join three reports, fork coder to edit, delegate verification, join coder, fork reviewer, handle REVISE, get dual PERFECT, join reviewer report, finish."
  },
  "flow": [
    {
      "wait": "manager-fork-inspector"
    },
    {
      "wait": "session-blogger"
    },
    {
      "bindChild": {
        "agent": "fast-inspector",
        "aliases": [
          "fast-inspector"
        ]
      }
    },
    {
      "wait": "inspector-report"
    },
    {
      "wait": "inspector-finished"
    },
    {
      "wait": "manager-join-1"
    },
    {
      "wait": "manager-fork-browser"
    },
    {
      "bindChild": {
        "agent": "fast-browser",
        "aliases": [
          "fast-browser"
        ]
      }
    },
    {
      "wait": "browser-report"
    },
    {
      "wait": "browser-finished"
    },
    {
      "wait": "manager-join-2"
    },
    {
      "wait": "manager-fork-meditator"
    },
    {
      "bindChild": {
        "agent": "fast-meditator",
        "aliases": [
          "fast-meditator"
        ]
      }
    },
    {
      "wait": "meditator-report"
    },
    {
      "wait": "meditator-finished"
    },
    {
      "wait": "manager-join-3"
    },
    {
      "wait": "manager-fork-coder"
    },
    {
      "bindChild": {
        "agent": "fast-coder",
        "aliases": [
          "fast-coder"
        ]
      }
    },
    {
      "wait": "coder-edit"
    },
    {
      "wait": "coder-finished"
    },
    {
      "wait": "manager-join-coder"
    },
    {
      "wait": "manager-fork-reviewer"
    },
    {
      "bindChild": {
        "agent": "fast-reviewer",
        "aliases": [
          "fast-reviewer"
        ]
      }
    },
    {
      "wait": "review-revise"
    },
    {
      "wait": "reviewer-revise-report"
    },
    {
      "wait": "manager-join-reviewer-revise"
    },
    {
      "wait": "manager-nudge-coder"
    },
    {
      "bindChild": {
        "agent": "fast-coder",
        "aliases": [
          "fast-coder"
        ]
      }
    },
    {
      "wait": "coder-fix"
    },
    {
      "wait": "coder-fix-finished"
    },
    {
      "wait": "manager-join-coder-fix"
    },
    {
      "wait": "manager-fork-reviewer-2"
    },
    {
      "bindChild": {
        "agent": "fast-reviewer",
        "aliases": [
          "fast-reviewer"
        ]
      }
    },
    {
      "wait": "review-perfect-1"
    },
    {
      "wait": "reviewer-after-first-perfect"
    },
    {
      "wait": "review-perfect-confirmed"
    },
    {
      "wait": "reviewer-final-report"
    },
    {
      "wait": "manager-join-reviewer-final"
    },
    {
      "wait": "manager-complete"
    },
    {
      "awaitTerminal": true,
      "requireAssistantTerminal": true
    },
    {
      "assertFacts": {
        "name": "ReviewVerdictRecorded",
        "gte": 3
      }
    },
    {
      "expectSatisfied": true
    }
  ],
  "pass": "Manager full loop canary passed.",
  "scripts": [
