{
  "scenario": "host-nudge",
  "scripts": [
    {
      "id": "parent-title",
      "lane": {
        "session": "parent-title",
        "role": "title",
        "turn": 1,
        "requestKind": "title"
      },
      "respond": {
        "type": "title",
        "text": "E2E Test Session"
      },
      "match": {}
    },
    {
      "id": "manager-fork-busy",
      "lane": {
        "session": "manager",
        "role": "manager",
        "turn": 1,
        "requestKind": "chat"
      },
      "match": {
        "requiredTools": [
          "fork",
          "join",
          "list"
        ],
        "forbiddenTools": [
          "read",
          "write",
          "edit",
          "bash",
          "glob",
          "grep",
          "verdict"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "fork",
        "args": {
          "agent": "coder",
          "prompt": "first busy run: stay streaming until nudged"
        }
      }
    },
    {
      "id": "coder-busy-hang",
      "lane": {
        "session": "coder",
        "role": "coder",
        "turn": 1,
        "requestKind": "chat"
      },
      "blocking": false,
      "neverEnd": true,
      "match": {
        "requiredTools": [
          "write"
        ]
      },
      "respond": {
        "type": "text",
        "text": "Coder first run still working."
      }
    },
    {
      "id": "manager-fork-nudge",
      "lane": {
        "session": "manager",
        "role": "manager",
        "turn": 2,
        "requestKind": "chat"
      },
      "match": {
        "requiredTools": [
          "fork",
          "join",
          "list"
        ],
        "forbiddenTools": [
          "read",
          "write",
          "edit",
          "bash",
          "glob",
          "grep",
          "verdict"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "fork",
        "args": {
          "agent": "coder",
          "prompt": "nudge continue second run while first is busy"
        }
      }
    },
    {
      "id": "session-blogger",
      "lane": {
        "session": "session-blogger",
        "role": "blogger",
        "turn": 1,
        "requestKind": "chat"
      },
      "blocking": false,
      "neverEnd": true,
      "match": {
        "userRegex": "You are the blogger of a coding agent session\\. Write one dense paragraph"
      },
      "respond": {
        "type": "text",
        "text": "Session background."
      }
    }
  ],
  "setup": {
    "project": {
      "files": {}
    },
    "strict": true
  },
  "session": {
    "agent": "manager",
    "bind": [
      "parent-title",
      "manager"
    ]
  },
  "prompt": {
    "agent": "manager",
    "text": "Fork a busy coder and nudge it while streaming."
  },
  "flow": [
    {
      "wait": "manager-fork-busy"
    },
    {
      "bindChild": {
        "agent": "coder",
        "aliases": [
          "coder"
        ]
      }
    },
    {
      "wait": "coder-busy-hang"
    },
    {
      "assertActiveRequests": {
        "gte": 1
      }
    },
    {
      "wait": "manager-fork-nudge"
    },
    {
      "assertActiveRequests": {
        "gte": 1
      }
    },
    {
      "custom": "proveNudge"
    },
    {
      "abort": true
    }
  ],
  "pass": "Host nudge canary passed: busy-overlap nudge while first run still streaming."
}
