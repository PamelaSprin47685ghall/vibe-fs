{
  "scenario": "inspector-oneshot",
  "scripts": [
    {
      "id": "coder-title",
      "lane": {
        "session": "coder-title",
        "role": "title",
        "turn": 1,
        "requestKind": "title"
      },
      "respond": {
        "type": "title",
        "text": "E2E Test Session"
      }
    },
    {
      "id": "coder-blogger-1",
      "lane": {
        "session": "coder-blogger",
        "role": "blogger",
        "turn": 1,
        "requestKind": "chat",
        "parentSession": "coder"
      },
      "blocking": false,
      "neverEnd": true,
      "match": {
        "userRegex": "You are the blogger of a coding agent session\\."
      },
      "respond": {
        "type": "text",
        "text": "coder blog"
      }
    },
    {
      "id": "coder-inspector",
      "lane": {
        "session": "fast-coder",
        "role": "coder",
        "turn": 1,
        "requestKind": "chat"
      },
      "match": {
        "requiredTools": [
          "inspector"
        ],
        "forbiddenTools": [
          "executor"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "inspector",
        "args": {
          "prompt": "Inspect the workspace and return factual findings relevant to the requested edit."
        }
      }
    },
    {
      "id": "coder-final",
      "lane": {
        "session": "fast-coder",
        "role": "coder",
        "turn": 2,
        "requestKind": "chat"
      },
      "match": {
        "requiredTools": [
          "inspector"
        ],
        "forbiddenTools": [
          "executor"
        ]
      },
      "respond": {
        "type": "text",
        "text": "Inspector investigation complete."
      }
    }
  ],
  "setup": {
    "project": {
      "files": {
        "AGENTS.md": "Inspector oneshot canary\n"
      }
    },
    "strict": true
  },
  "session": {
    "agent": "fast-coder",
    "bind": [
      "coder-title",
      "fast-coder"
    ]
  },
  "prompt": {
    "agent": "fast-coder",
    "text": "Use inspector once to investigate a precise workspace fact needed for the edit. Then stop with a short summary."
  },
  "flow": [
    {
      "wait": "coder-title"
    },
    {
      "wait": "coder-blogger-1",
      "lane": "coder-blogger"
    },
    {
      "wait": "coder-inspector"
    },
    {
      "wait": "coder-final"
    },
    {
      "awaitTerminal": true,
      "requireAssistantTerminal": true
    },
    {
      "expectSatisfied": true
    }
  ],
  "pass": "Inspector oneshot canary passed: coder invoked inspector for a narrow investigation."
}
