      },
      "reusable": true,
      "match": {
        "requiredTools": [
          "verdict"
        ],
        "afterToolResult": false,
        "userRegex": "PERFECT requires confirmation|Continue the confirmation"
      },
      "respond": {
        "type": "tool-call",
