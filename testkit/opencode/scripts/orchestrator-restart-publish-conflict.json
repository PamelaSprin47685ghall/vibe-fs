{
  "scenario": "orch-restart-publish",
  "setup": {
    "project": {
      "files": {
        "AGENTS.md": "- orchestrator restart publish canary (rebase-conflict)\n",
        "README.md": "# orchestrator-restart-publish project (rebase-conflict)\n"
      }
    },
    "strict": true
  },
  "session": {
    "agent": "fast-orchestrator",
    "bind": [
      "title",
      "fast-orchestrator"
    ]
  },
  "prompt": {
    "agent": "fast-orchestrator",
    "text": "Ship publish_proof.txt to the target branch."
  },
  "flow": [
    {
      "afterExpectation": {
        "id": "manager-fork-coder",
        "gitConflictProof": true
      }
    },
    {
      "afterExpectation": {
        "id": "manager-conflict-resume",
        "restart": true
      }
    },
    {
      "wait": "orch-fork-manager"
    },
    {
      "wait": "manager-fork-coder"
    },
    {
      "wait": "coder-write"
    },
    {
      "wait": "manager-terminal"
    },
    {
      "wait": "reviewer-perfect-1"
    },
    {
      "wait": "reviewer-after-tool-text"
    },
    {
      "wait": "reviewer-perfect-2"
    },
    {
      "wait": "reviewer-after-tool-text"
    },
    {
      "waitFact": {
        "name": "OrchestratorPreRebaseReviewConfirmed",
        "eq": 1
      }
    },
    {
      "wait": "manager-conflict-resume"
    },
    {
      "awaitRestart": true
    },
    {
      "loadScripts": "orchestrator-restart-publish-conflict-recovery.json"
    },
    {
      "prompt": {
        "agent": "fast-orchestrator",
        "text": "Continue the publish job and join its result."
      }
    },
    {
      "wait": "manager-conflict-resume-2",
      "timeoutMs": 20000
    },
    {
      "wait": "reviewer-perfect-3",
      "timeoutMs": 20000
    },
    {
      "wait": "reviewer-perfect-4",
      "timeoutMs": 20000
    },
    {
      "wait": "orch-join-2",
      "timeoutMs": 20000
    },
    {
      "wait": "orch-final",
      "timeoutMs": 20000
    },
    {
      "awaitTerminal": true,
      "requireAssistantTerminal": false,
      "timeoutMs": 20000
    },
    {
      "expectSatisfied": true
    }
  ],
  "pass": "Orchestrator restart publish canary passed: crash-during-rebase-conflict recovers to exactly-once publish.",
  "scripts": [
    {
      "id": "orch-title",
      "lane": {
        "session": "title",
        "role": "title",
        "turn": 1,
        "requestKind": "title"
      },
      "match": {},
      "respond": {
        "type": "title",
        "text": "E2E Test Session"
      }
    },
    {
      "id": "orch-fork-manager",
      "lane": {
        "session": "fast-orchestrator",
        "role": "orchestrator",
        "turn": 1,
        "requestKind": "chat"
      },
      "match": {
        "requiredTools": [
          "fork-manager",
          "join"
        ],
        "forbiddenTools": [
          "list"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "fork-manager",
        "args": {
          "prompt": "Ship publish_proof.txt to the target branch.",
          "agent": "fast-manager"
        }
      }
    },
    {
      "id": "orch-join",
      "lane": {
        "session": "fast-orchestrator",
        "role": "orchestrator",
        "turn": 2,
        "requestKind": "chat"
      },
      "match": {
        "requiredTools": [
          "fork-manager",
          "join"
        ],
        "forbiddenTools": [
          "list"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "join",
        "args": {}
      }
    },
    {
      "id": "orch-join-2",
      "lane": {
        "session": "fast-orchestrator",
        "role": "orchestrator",
        "turn": 3,
        "requestKind": "chat"
      },
      "match": {
        "requiredTools": [
          "fork-manager",
          "join"
        ],
        "forbiddenTools": [
          "list"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "join",
        "args": {}
      }
    },
    {
      "id": "orch-final",
      "lane": {
        "session": "fast-orchestrator",
        "role": "orchestrator",
        "turn": 4,
        "requestKind": "chat"
      },
      "match": {
        "requiredTools": [
          "fork-manager",
          "join"
        ],
        "forbiddenTools": [
          "list"
        ]
      },
      "respond": {
        "type": "text",
        "text": "Publish completed."
      }
    },
    {
      "id": "manager-fork-coder",
      "lane": {
        "session": "fast-manager",
        "role": "manager",
        "turn": 1,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "match": {
        "requiredTools": [
          "fork",
          "join",
          "list"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "fork",
        "args": {
          "agent": "fast-coder",
          "prompt": "Write publish_proof.txt."
        }
      }
    },
    {
      "id": "manager-join-coder",
      "lane": {
        "session": "fast-manager",
        "role": "manager",
        "turn": 2,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "match": {
        "requiredTools": [
          "fork",
          "join",
          "list"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "join",
        "args": {}
      }
    },
    {
      "id": "manager-terminal",
      "lane": {
        "session": "fast-manager",
        "role": "manager",
        "turn": 3,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "match": {
        "requiredTools": [
          "fork",
          "join",
          "list"
        ]
      },
      "respond": {
        "type": "text",
        "text": "Manager finished."
      }
    },
    {
      "id": "coder-write",
      "lane": {
        "session": "fast-coder",
        "role": "coder",
        "turn": 1,
        "requestKind": "chat",
        "parentSession": "manager"
      },
      "match": {
        "requiredTools": [
          "write"
        ]
      },
      "respond": {
        "type": "tool-call",
        "tool": "write",
        "args": {
          "filePath": "publish_proof.txt",
          "content": "Published by orchestrator canary\n"
        }
      }
    },
    {
      "id": "coder-terminal",
      "lane": {
        "session": "fast-coder",
        "role": "coder",
        "turn": 2,
        "requestKind": "chat",
        "parentSession": "manager"
      },
      "match": {},
      "respond": {
        "type": "text",
        "text": "Coder finished."
      }
    },
    {
      "id": "manager-conflict-resume",
      "lane": {
        "session": "fast-manager",
        "role": "manager",
        "turn": 4,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "match": {
        "userRegex": "\\[CONFLICT RESUMPTION\\]"
      },
      "respond": {
        "type": "text",
        "text": "Resuming rebase resolution."
      }
    },
    {
      "id": "manager-conflict-resume-2",
      "lane": {
        "session": "fast-manager",
        "role": "manager",
        "turn": 5,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "match": {
        "userRegex": "\\[CONFLICT RESUMPTION\\]"
      },
      "respond": {
        "type": "text",
        "text": "Resolved rebase resolution."
      }
    },
    {
      "id": "session-blogger",
      "lane": {
        "session": "session-blogger",
        "role": "blogger",
        "turn": 1,
        "requestKind": "chat"
      },
      "match": {
        "userRegex": "You are the blogger of a coding agent session\\. Write one dense paragraph"
      },
      "respond": {
        "type": "text",
        "text": "Session background."
      },
      "neverEnd": true,
      "blocking": false
    },
    {
      "id": "session-blogger-reanchor",
      "lane": {
        "session": "session-blogger-reanchor",
        "role": "blogger",
        "turn": 1,
        "requestKind": "chat"
      },
      "match": {
        "userRegex": "You are the blogger of a coding agent session\\. This session resumed after a restart"
      },
      "respond": {
        "type": "text",
        "text": "Session reanchor background."
      },
      "neverEnd": true,
      "blocking": false
    },
    {
      "id": "reviewer-after-tool-text",
      "lane": {
        "session": "reviewer-sidecar",
        "role": "reviewer",
        "turn": 1,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "pathless": true,
      "reusable": true,
      "blocking": false,
      "neverEnd": false,
      "match": {
        "requiredTools": [
          "verdict"
        ],
        "afterToolResult": true
      },
      "respond": {
        "type": "text",
        "text": "Reviewer intermediate text after verdict tool."
      }
    },
    {
      "id": "reviewer-perfect-1",
      "lane": {
        "session": "fast-reviewer",
        "role": "reviewer",
        "turn": 1,
        "requestKind": "chat",
        "parentSession": "orchestrator"
      },
      "reusable": true,
      "match": {
        "requiredTools": [
          "verdict"
        ],
        "user": "Review the current worktree for correctness",
        "afterToolResult": false
      },
      "respond": {
        "type": "tool-call",
        "tool": "verdict",
        "args": {
          "verdict": "PERFECT"
        }
      }
    },
    {
      "id": "reviewer-perfect-2",
      "lane": {
        "session": "fast-reviewer",
        "role": "reviewer",
        "turn": 2,
