<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Wanxiangshu.Next</RootNamespace>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OtherFlags>--nowarn:1182 --nowarn:1108</OtherFlags>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
    <!-- Read-only NuGet http-cache (read-only home subvolume) makes the audit
         write fail with NU1900 as error on every restore; the audit is a
         vulnerability scan, not a build contract, and disabling it is the only
         way Fable's internal msbuild restore can run on this machine. -->
    <NuGetAudit>false</NuGetAudit>
    <ArtifactsDir Condition="'$(ArtifactsDir)' == ''">$(MSBuildThisFileDirectory)../artifacts/</ArtifactsDir>
    <BaseIntermediateOutputPath>$(ArtifactsDir)obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <BaseOutputPath>$(ArtifactsDir)bin/$(MSBuildProjectName)/</BaseOutputPath>
  </PropertyGroup>
</Project>
