<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>persistence</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>eventstore-append-result-contract</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>durable-events</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>eventstore-append-result-contract</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
