<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>work</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>mission-work-core</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>work</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>mission-work-core</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
