<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>process</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>process-processrequest</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>process-execution</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>process-processrequest</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Process/ProcessRequest.fsi"/>
    <Compile Include="Process/ProcessRequest.fs"/>
    <Compile Include="Process/PtyTypes.fsi"/>
    <Compile Include="Process/PtyTypes.fs"/>
  </ItemGroup>
</Project>
