<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>persistence</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>eventstore-merge-runtime</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>durable-convergence</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>eventstore-merge-runtime</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>runtime</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.persistence-eventstore-storetypes.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-convergence.persistence-eventstore-processeventlog.fsproj"/>
    <Compile Include="Persistence/EventStore/EventKWayMerge.fsi"/>
    <Compile Include="Persistence/EventStore/EventKWayMerge.fs"/>
  </ItemGroup>
</Project>
