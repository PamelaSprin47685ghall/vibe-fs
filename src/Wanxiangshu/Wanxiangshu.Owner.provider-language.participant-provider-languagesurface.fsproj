<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>provider</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>participant-provider-languagesurface</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>provider-language</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>participant-provider-languagesurface</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.cognitive-environment.resources-promptresources.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.host-boundary.provider-system-transform.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.provider-language.participant-provider-language.fsproj"/>
    <Compile Include="Participant/Provider/LanguageSurface.fsi"/>
    <Compile Include="Participant/Provider/LanguageSurface.fs"/>
  </ItemGroup>
</Project>
