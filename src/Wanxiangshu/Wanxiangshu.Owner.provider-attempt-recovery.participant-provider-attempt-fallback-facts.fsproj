<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>provider</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>participant-provider-attempt-fallback-facts</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>provider-attempt-recovery</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>participant-provider-attempt-fallback-facts</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-outcome.fsproj"/>
    <Compile Include="Participant/Provider/Attempt/Fallback/Facts.fsi"/>
    <Compile Include="Participant/Provider/Attempt/Fallback/Facts.fs"/>
  </ItemGroup>
</Project>
