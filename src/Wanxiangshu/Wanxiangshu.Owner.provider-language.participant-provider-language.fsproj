<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>runtime-platform</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>participant-provider-language</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>provider-language</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>participant-provider-language</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-llm-facing.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.runtime-platform.language.fsproj"/>
    <Compile Include="Participant/Provider/SessionLanguage.fsi"/>
    <Compile Include="Participant/Provider/SessionLanguage.fs"/>
    <Compile Include="Participant/Provider/Prose.fsi"/>
    <Compile Include="Participant/Provider/Prose.fs"/>
    <Compile Include="OpenCode/Host/ProviderLanguageBinding.fsi"/>
    <Compile Include="OpenCode/Host/ProviderLanguageBinding.fs"/>
  </ItemGroup>
</Project>
