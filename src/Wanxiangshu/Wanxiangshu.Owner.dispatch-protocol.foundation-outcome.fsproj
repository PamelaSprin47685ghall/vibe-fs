<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSemanticOwner>dispatch-protocol</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>foundation-outcome</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
    <WanxiangshuSubsystem>chat-execution</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>outcome</WanxiangshuCompileShard>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.participant-identity.foundation-roles.fsproj"/>
    <Compile Include="Foundation/Outcome.fsi"/>
    <Compile Include="Foundation/Outcome.fs"/>
    <Compile Include="Foundation/OutcomeSurface.fsi"/>
    <Compile Include="Foundation/OutcomeSurface.fs"/>
  </ItemGroup>
</Project>
