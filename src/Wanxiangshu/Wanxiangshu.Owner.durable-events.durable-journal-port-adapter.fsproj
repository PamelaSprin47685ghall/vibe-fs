<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>persistence</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>durable-journal-port-adapter</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>durable-events</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>durable-journal-port-adapter</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.delegation.delegation-journal-port.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.composition-durable-fact.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.persistence-journal-agentjournal.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.runtime-platform.digest.fsproj"/>
    <Compile Include="Composition/Durable/AgentJournalPortAdapter.fsi"/>
    <Compile Include="Composition/Durable/AgentJournalPortAdapter.fs"/>
  </ItemGroup>
</Project>
