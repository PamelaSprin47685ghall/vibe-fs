<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSemanticOwner>knowledge-reuse</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>opencode-tools-fetchtool</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
    <WanxiangshuSubsystem>host</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>opencode-tools-fetchtool</WanxiangshuCompileShard>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.persistence-eventstore-storetypes.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.host-boundary.host-tool-adapter.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.knowledge-reuse.repository-knowledge-casebook-model.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.knowledge-reuse.repository-knowledge-casebook-bookkeeper.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.participant-identity.foundation-roles.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.provider-language.participant-provider-language.fsproj"/>
    <Compile Include="OpenCode/Tools/FetchTool.fsi"/>
    <Compile Include="OpenCode/Tools/FetchTool.fs"/>
  </ItemGroup>
</Project>
