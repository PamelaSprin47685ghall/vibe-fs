<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>enforcer</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>resources-promptsurface</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>cognitive-environment</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>resources-promptsurface</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.cognitive-environment.resources-promptresources.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.cognitive-environment.resources-runtimeresources.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.cognitive-environment.resources-promptcatalog.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.distribution.resources-enforcercatalogresource.fsproj"/>
    <Compile Include="Resources/PromptSurface.fsi"/>
    <Compile Include="Resources/PromptSurface.fs"/>
  </ItemGroup>
</Project>
