<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>context</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>context-prefix-epoch</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>prefix-stability</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>context-prefix-epoch</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.context-compression.context-companion-fact.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.prefix-stability.context-prefix-candidate.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.provider-attempt-recovery.participant-provider-attempt-requestkind.fsproj"/>
    <Compile Include="Context/Prefix/ProbeSelection.fsi"/>
    <Compile Include="Context/Prefix/ProbeSelection.fs"/>
    <Compile Include="Context/Prefix/Projection.fsi"/>
    <Compile Include="Context/Prefix/Projection.fs"/>
    <Compile Include="Context/Prefix/Epoch.fsi"/>
    <Compile Include="Context/Prefix/Epoch.fs"/>
    <Compile Include="Context/Prefix/Surface.fsi"/>
    <Compile Include="Context/Prefix/Surface.fs"/>
  </ItemGroup>
</Project>
