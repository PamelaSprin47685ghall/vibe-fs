<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>provider</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>host-session-snapshot-contract</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>host-boundary</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>host-session-snapshot-contract</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.host-boundary.host-message-contract.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.host-boundary.host-opencode-types.fsproj"/>
    <Compile Include="Foundation/HostSessionSnapshot.fsi"/>
    <Compile Include="Foundation/HostSessionSnapshot.fs"/>
  </ItemGroup>
</Project>
