<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>host</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>host-root-workspace-runtime</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>host-boundary</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>host-root-workspace-runtime</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>runtime</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.host-boundary.host-root-workspace-contract.fsproj"/>
    <Compile Include="OpenCode/Host/RootWorkspaceRuntime.fsi"/>
    <Compile Include="OpenCode/Host/RootWorkspaceRuntime.fs"/>
  </ItemGroup>
</Project>
