<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>session-lifecycle</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>execution-session-sessionstartedatprojection</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>time-capability</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>execution-session-sessionstartedatprojection</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-outcome.fsproj"/>
    <Compile Include="Execution/Session/SessionStartedAtProjection.fsi"/>
    <Compile Include="Execution/Session/SessionStartedAtProjection.fs"/>
    <Compile Include="Execution/Session/SessionStartedAtPort.fsi"/>
    <Compile Include="Execution/Session/SessionStartedAtPort.fs"/>
  </ItemGroup>
</Project>
