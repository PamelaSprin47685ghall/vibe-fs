<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>sphinx</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>sphinx-serve-runtime</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>epistemic-reasoning</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>sphinx-serve-runtime</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>runtime</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.epistemic-reasoning.sphinx-runtime.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.epistemic-reasoning.sphinx-mcp.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.epistemic-reasoning.sphinx-event-vocabulary-contract.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.persistence-eventstore-model.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.persistence-eventstore-storetypes.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-outcome.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.intra-participant-parallelism.foundation-taskresult.fsproj"/>
    <Compile Include="Sphinx/GenericDurability.fsi"/>
    <Compile Include="Sphinx/GenericDurability.fs"/>
    <Compile Include="Sphinx/McpServer.fsi"/>
    <Compile Include="Sphinx/McpServer.fs"/>
    <Compile Include="Sphinx/Surface.fsi"/>
    <Compile Include="Sphinx/Surface.fs"/>
  </ItemGroup>
</Project>
