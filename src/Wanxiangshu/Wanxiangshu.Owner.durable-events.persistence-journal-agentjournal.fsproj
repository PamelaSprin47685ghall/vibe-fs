<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>persistence</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>persistence-journal-agentjournal</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>durable-events</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>persistence-journal-agentjournal</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-outcome.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.delegation.delegation-linkage-projection.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.composition-durable-fact.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.composition-durable-projection.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.persistence-journal-promptfactcodec.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.execution-failure-policy.execution-failure-model.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.host-boundary.host-fatal-effect.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.intra-participant-parallelism.foundation-async-support.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.obligation-ledger.mission-obligation-todo-model.fsproj"/>
    <Compile Include="Persistence/Journal/Writer.fsi"/>
    <Compile Include="Persistence/Journal/Writer.fs"/>
    <Compile Include="Persistence/Journal/AgentJournal.fsi"/>
    <Compile Include="Persistence/Journal/AgentJournal.fs"/>
    <Compile Include="Persistence/Journal/SharedAgentJournal.fsi"/>
    <Compile Include="Persistence/Journal/SharedAgentJournal.fs"/>
  </ItemGroup>
</Project>