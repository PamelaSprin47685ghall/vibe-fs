    <Compile Include="OpenCode/Codec/LoopEventCodec.fs"/>
    <Compile Include="OpenCode/Codec/HostMessageCodec.fsi"/>
    <Compile Include="OpenCode/Codec/HostMessageCodec.fs"/>
    <Compile Include="OpenCode/Codec/ToolHostCodec.fsi"/>
    <Compile Include="OpenCode/Codec/ToolHostCodec.fs"/>
    <Compile Include="OpenCode/Codec/ToolHostSurface.fsi"/>
    <Compile Include="OpenCode/Codec/ToolHostSurface.fs"/>
    <Compile Include="OpenCode/Signals/HostSignal.fsi"/>
    <Compile Include="OpenCode/Signals/HostSignal.fs"/>
    <Compile Include="OpenCode/Signals/HostSignalAdapter.fsi"/>
    <Compile Include="OpenCode/Signals/HostSignalAdapter.fs"/>
    <Compile Include="OpenCode/Host/HostSignalSurface.fsi"/>
    <Compile Include="OpenCode/Host/HostSignalSurface.fs"/>
    <Compile Include="OpenCode/Signals/HostSignalSubscribe.fsi"/>
    <Compile Include="OpenCode/Signals/HostSignalSubscribe.fs"/>
    <Compile Include="OpenCode/Host/HostSignalSubscribeSurface.fsi"/>
    <Compile Include="OpenCode/Host/HostSignalSubscribeSurface.fs"/>
    <Compile Include="OpenCode/Host/Events.fsi"/>
    <Compile Include="OpenCode/Host/Events.fs"/>
    <Compile Include="OpenCode/Host/SharedTerminalBus.fsi"/>
    <Compile Include="OpenCode/Host/SharedTerminalBus.fs"/>
    <Compile Include="OpenCode/Host/EventsSurface.fsi"/>
    <Compile Include="OpenCode/Host/EventsSurface.fs"/>
