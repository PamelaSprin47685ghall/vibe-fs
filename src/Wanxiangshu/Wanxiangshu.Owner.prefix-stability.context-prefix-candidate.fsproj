<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>context</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>context-prefix-candidate</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>prefix-stability</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>context-prefix-candidate</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <Compile Include="Context/Prefix/Candidate.fsi"/>
    <Compile Include="Context/Prefix/Candidate.fs"/>
  </ItemGroup>
</Project>
