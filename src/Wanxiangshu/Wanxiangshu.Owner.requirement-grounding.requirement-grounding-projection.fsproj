<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <WanxiangshuSubsystem>requirements</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>requirement-grounding-projection</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>requirement-grounding</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>requirement-grounding-projection</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.requirement-grounding.requirement-grounding-model.fsproj"/>
    <Compile Include="OpenCode/Host/RequirementGrounding/Projection.fsi"/>
    <Compile Include="OpenCode/Host/RequirementGrounding/Projection.fs"/>
    <Compile Include="OpenCode/Host/RequirementGrounding/Port.fsi"/>
    <Compile Include="OpenCode/Host/RequirementGrounding/Port.fs"/>
  </ItemGroup>
</Project>
