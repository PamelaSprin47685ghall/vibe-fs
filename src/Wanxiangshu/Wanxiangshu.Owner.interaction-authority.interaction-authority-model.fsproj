<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <WanxiangshuSubsystem>authority</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>interaction-authority-model</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>interaction-authority</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>interaction-authority-model</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-outcome.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.interaction-authority.interaction-authority-identityseed.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.participant-identity.participant-persona.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.office-capability.foundation-officecapability.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.provider-attempt-recovery.participant-provider-attempt-requestkind.fsproj"/>
    <Compile Include="Interaction/Authority/Model.fsi"/>
    <Compile Include="Interaction/Authority/Model.fs"/>
  </ItemGroup>
</Project>
