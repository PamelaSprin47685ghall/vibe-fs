    <Compile Include="Repository/Programming/Js/Anchor.fs"/>
    <Compile Include="Repository/Programming/Js/Transaction.fsi"/>
    <Compile Include="Repository/Programming/Js/Transaction.fs"/>
    <Compile Include="Repository/Programming/Js/Utf8Fs.fsi"/>
    <Compile Include="Repository/Programming/Js/Utf8Fs.fs"/>
    <Compile Include="Repository/Programming/Js/GlobFs.fsi"/>
    <Compile Include="Repository/Programming/Js/GlobFs.fs"/>
    <Compile Include="Repository/Programming/Js/AnchorFs.fsi"/>
    <Compile Include="Repository/Programming/Js/AnchorFs.fs"/>
    <Compile Include="Repository/Programming/Js/MutationFs.fsi"/>
