<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>sphinx</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>sphinx-integration-rules</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>epistemic-reasoning</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>sphinx-integration-rules</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.durable-convergence.eventstore-integrator-contract.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.epistemic-reasoning.sphinx-event-vocabulary-contract.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.epistemic-reasoning.sphinx-runtime.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.persistence-eventstore-storetypes.fsproj"/>
    <Compile Include="Sphinx/IntegrationRules.fsi"/>
    <Compile Include="Sphinx/IntegrationRules.fs"/>
  </ItemGroup>
</Project>
