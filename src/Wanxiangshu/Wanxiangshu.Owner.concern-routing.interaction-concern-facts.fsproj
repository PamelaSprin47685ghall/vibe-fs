<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>interaction</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>interaction-concern-facts</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>concern-routing</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>interaction-concern-facts</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <Compile Include="Interaction/Concern/Facts.fsi"/>
    <Compile Include="Interaction/Concern/Facts.fs"/>
    <Compile Include="Interaction/Concern/Projection.fsi"/>
    <Compile Include="Interaction/Concern/Projection.fs"/>
    <Compile Include="Interaction/Concern/JournalPort.fsi"/>
    <Compile Include="Interaction/Concern/JournalPort.fs"/>
    <Compile Include="Interaction/Concern/Surface.fsi"/>
    <Compile Include="Interaction/Concern/Surface.fs"/>
  </ItemGroup>
</Project>
