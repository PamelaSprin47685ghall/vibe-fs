<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>enforcer</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>enforcer-institutionallearning-facts</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>institutional-learning</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>enforcer-institutionallearning-facts</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.behavior-diagnosis.enforcer-catalog.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.runtime-platform.digest.fsproj"/>
    <Compile Include="Enforcer/InstitutionalLearning/Facts.fsi"/>
    <Compile Include="Enforcer/InstitutionalLearning/Facts.fs"/>
    <Compile Include="Enforcer/InstitutionalLearning/Enhancer.fsi"/>
    <Compile Include="Enforcer/InstitutionalLearning/Enhancer.fs"/>
    <Compile Include="Enforcer/InstitutionalLearning/Projection.fsi"/>
    <Compile Include="Enforcer/InstitutionalLearning/Projection.fs"/>
    <Compile Include="Enforcer/InstitutionalLearning/JournalPort.fsi"/>
    <Compile Include="Enforcer/InstitutionalLearning/JournalPort.fs"/>
    <Compile Include="Enforcer/InstitutionalLearning/Surface.fsi"/>
    <Compile Include="Enforcer/InstitutionalLearning/Surface.fs"/>
  </ItemGroup>
</Project>
