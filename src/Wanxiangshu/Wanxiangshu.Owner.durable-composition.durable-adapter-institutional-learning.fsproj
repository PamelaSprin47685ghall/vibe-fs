<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <WanxiangshuSubsystem>durable-composition</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>durable-adapter-institutional-learning</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>durable-composition</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>durable-adapter-institutional-learning</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-outcome.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.composition-durable-fact.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.composition-durable-projection.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.persistence-journal-agentjournal.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.institutional-learning.enforcer-institutionallearning-facts.fsproj"/>
    <Compile Include="Composition/Durable/InstitutionalLearningJournalAdapter.fsi"/>
    <Compile Include="Composition/Durable/InstitutionalLearningJournalAdapter.fs"/>
  </ItemGroup>
</Project>
