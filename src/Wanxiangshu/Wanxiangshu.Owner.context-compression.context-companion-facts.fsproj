<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>context</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>context-companion-facts</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>context-compression</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>context-companion-facts</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-outcome.fsproj"/>
    <Compile Include="Context/Companion/Facts.fsi"/>
    <Compile Include="Context/Companion/Facts.fs"/>
  </ItemGroup>
</Project>
