<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>participant</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>foundation-roles</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>participant-identity</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>foundation-roles</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Foundation/Roles.fsi"/>
    <Compile Include="Foundation/Roles.fs"/>
    <Compile Include="Foundation/RolesSurface.fsi"/>
    <Compile Include="Foundation/RolesSurface.fs"/>
  </ItemGroup>
</Project>
