<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>sphinx</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>sphinx-mcp</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>epistemic-reasoning</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>sphinx-mcp</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Sphinx/Mcp.fsi"/>
    <Compile Include="Sphinx/Mcp.fs"/>
  </ItemGroup>
</Project>
