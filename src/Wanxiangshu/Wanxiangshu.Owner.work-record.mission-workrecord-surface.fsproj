<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>work</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>mission-workrecord-surface</WanxiangshuCompileShard>
