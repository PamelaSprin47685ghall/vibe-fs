<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <WanxiangshuSubsystem>durable-composition</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>durable-adapter-requirement-grounding</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>durable-composition</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>durable-adapter-requirement-grounding</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.composition-durable-fact.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.composition-durable-projection.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.persistence-journal-agentjournal.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.requirement-grounding.host-fact.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.requirement-grounding.requirement-grounding-projection.fsproj"/>
    <Compile Include="Composition/Durable/RequirementGroundingJournalAdapter.fsi"/>
    <Compile Include="Composition/Durable/RequirementGroundingJournalAdapter.fs"/>
  </ItemGroup>
</Project>
