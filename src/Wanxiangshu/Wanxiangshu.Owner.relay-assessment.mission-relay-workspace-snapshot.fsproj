<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>relay</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>mission-relay-workspace-snapshot</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>relay-assessment</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>mission-relay-workspace-snapshot</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>adapter</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.runtime-platform.digest.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.relay-incumbency.mission-relay-core.fsproj"/>
    <Compile Include="Mission/Relay/OpenCode/WorkspaceSnapshot.fsi"/>
    <Compile Include="Mission/Relay/OpenCode/WorkspaceSnapshot.fs"/>
  </ItemGroup>
</Project>
