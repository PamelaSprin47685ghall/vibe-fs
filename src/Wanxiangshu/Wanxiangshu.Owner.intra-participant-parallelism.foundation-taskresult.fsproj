<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSemanticOwner>intra-participant-parallelism</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>foundation-taskresult</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
    <WanxiangshuSubsystem>runtime-platform</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>task-result</WanxiangshuCompileShard>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Foundation/TaskResult.fsi"/>
    <Compile Include="Foundation/TaskResult.fs"/>
    <Compile Include="Foundation/FsToolkitFableCompat.fsi"/>
    <Compile Include="Foundation/FsToolkitFableCompat.fs"/>
  </ItemGroup>
</Project>
