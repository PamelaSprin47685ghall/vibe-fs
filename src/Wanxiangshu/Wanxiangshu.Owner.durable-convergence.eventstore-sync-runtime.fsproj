<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>persistence</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>eventstore-sync-runtime</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>durable-convergence</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>eventstore-sync-runtime</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.durable-convergence.eventstore-process-log.fsproj"/>
    <Compile Include="Persistence/EventStore/RetentionSurface.fsi"/>
    <Compile Include="Persistence/EventStore/RetentionSurface.fs"/>
  </ItemGroup>
</Project>
