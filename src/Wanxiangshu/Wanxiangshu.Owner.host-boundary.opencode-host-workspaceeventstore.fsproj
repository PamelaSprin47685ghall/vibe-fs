<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>host</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>opencode-host-workspaceeventstore</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>host-boundary</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>opencode-host-workspaceeventstore</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.eventstore-authoritative-vocabulary.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-convergence.persistence-eventstore-canonicalintegrator.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-convergence.persistence-eventstore-processeventlog.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.persistence-eventstore-storetypes.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.persistence-journal-eventstorewriter.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.repository-programming.repository-programming-js-integration-rules.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.knowledge-reuse.knowledge-integration-rules.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.speculative-investigation.strength-integration-rules.fsproj"/>
    <Compile Include="OpenCode/Host/WorkspaceEventStore.fsi"/>
    <Compile Include="OpenCode/Host/WorkspaceEventStore.fs"/>
  </ItemGroup>
</Project>
