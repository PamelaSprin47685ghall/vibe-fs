    <Compile Include="Host/Ports/ModelRouting.fs"/>
    <Compile Include="Host/Ports/Sessions.fsi"/>
    <Compile Include="Host/Ports/Sessions.fs"/>
    <Compile Include="Host/Ports/Prompts.fsi"/>
    <Compile Include="Host/Ports/Prompts.fs"/>
    <Compile Include="Host/Ports/Transcript.fsi"/>
    <Compile Include="Host/Ports/Transcript.fs"/>
    <Compile Include="Host/Ports/Tools.fsi"/>
    <Compile Include="Host/Ports/Tools.fs"/>
    <Compile Include="Host/Ports/ToolGates.fsi"/>
    <Compile Include="Host/Ports/ToolGates.fs"/>
    <Compile Include="Host/Ports/Signals.fsi"/>
    <Compile Include="Host/Ports/Signals.fs"/>
    <Compile Include="Host/Ports/TurnTransforms.fsi"/>
    <Compile Include="Host/Ports/TurnTransforms.fs"/>
    <Compile Include="Host/Ports/Compaction.fsi"/>
    <Compile Include="Host/Ports/Compaction.fs"/>
    <Compile Include="Host/Ports/Lifecycle.fsi"/>
    <Compile Include="Host/Ports/Lifecycle.fs"/>
