<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>relay</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>mission-relay-core</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>relay-incumbency</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>mission-relay-core</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Mission/Relay/Contract.fsi"/>
    <Compile Include="Mission/Relay/Contract.fs"/>
  </ItemGroup>
</Project>
