<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSemanticOwner>context-compression</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>opencode-host-declaredcontextlimit</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
    <WanxiangshuSubsystem>host</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>opencode-host-declaredcontextlimit</WanxiangshuCompileShard>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="OpenCode/Host/ProviderTokenUse.fsi"/>
    <Compile Include="OpenCode/Host/ProviderTokenUse.fs"/>
    <Compile Include="OpenCode/Host/DeclaredContextLimit.fsi"/>
    <Compile Include="OpenCode/Host/DeclaredContextLimit.fs"/>
  </ItemGroup>
</Project>
