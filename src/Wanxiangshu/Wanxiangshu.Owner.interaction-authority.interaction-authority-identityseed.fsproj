<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>authority</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>interaction-authority-identityseed</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>interaction-authority</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>interaction-authority-identityseed</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-outcome.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.participant-identity.participant-persona.fsproj"/>
    <Compile Include="Interaction/Authority/IdentitySeed.fsi"/>
    <Compile Include="Interaction/Authority/IdentitySeed.fs"/>
    <Compile Include="Interaction/Authority/Origin.fsi"/>
    <Compile Include="Interaction/Authority/Origin.fs"/>
    <Compile Include="Interaction/Authority/Facts.fsi"/>
    <Compile Include="Interaction/Authority/Facts.fs"/>
    <Compile Include="Interaction/Authority/PromptSessionFact.fsi"/>
    <Compile Include="Interaction/Authority/PromptSessionFact.fs"/>
  </ItemGroup>
</Project>
