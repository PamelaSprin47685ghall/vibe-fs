<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>application-composition</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>opencode-host-deliverywitnesswriter</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>host-boundary</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>opencode-host-deliverywitnesswriter</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.runtime-platform.digest.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-composition.host-fact-cases.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-composition.durable-adapter-delegation.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.persistence-journal-agentjournal.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.persistence-journal-promptfactcodec.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.repository-programming.repository-programming-js-toolbindings.fsproj"/>
    <Compile Include="OpenCode/Host/DeliveryWitnessWriter.fsi"/>
    <Compile Include="OpenCode/Host/DeliveryWitnessWriter.fs"/>
  </ItemGroup>
</Project>
