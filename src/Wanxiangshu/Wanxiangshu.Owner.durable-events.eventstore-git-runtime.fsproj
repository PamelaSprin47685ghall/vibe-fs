<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>persistence</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>eventstore-git-runtime</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>durable-events</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>eventstore-git-runtime</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>runtime</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.eventstore-git-contract.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.process-execution.process-node-host-adapter.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.intra-participant-parallelism.foundation-taskresult.fsproj"/>
    <Compile Include="Persistence/EventStore/ProcessGitRawStore.fsi"/>
    <Compile Include="Persistence/EventStore/ProcessGitRawStore.fs"/>
  </ItemGroup>
</Project>
