<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSemanticOwner>time-capability</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>foundation-temporal</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
    <WanxiangshuSubsystem>process</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>foundation-temporal</WanxiangshuCompileShard>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.action-affordance.opencode-tools-managedagent.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.delegation.execution-delegation-fact.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.process-execution.process-processrequest.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.time-capability.execution-session-sessionstartedatprojection.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.time-capability.foundation-temporal-contract.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.time-capability.process-deadline-contract.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.time-capability.process-node-timing-adapter.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.time-capability.process-virtual-timing.fsproj"/>
    <Compile Include="Process/DeadlineSurface.fsi"/>
    <Compile Include="Process/DeadlineSurface.fs"/>
    <Compile Include="Process/Surface.fsi"/>
    <Compile Include="Process/Surface.fs"/>
  </ItemGroup>
</Project>
