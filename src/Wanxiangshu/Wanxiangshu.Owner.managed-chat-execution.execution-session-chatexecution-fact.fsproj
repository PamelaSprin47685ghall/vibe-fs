<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>chat-execution</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>execution-session-chatexecution-fact</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>managed-chat-execution</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>execution-session-chatexecution-fact</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>composition</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.durable-events.composition-durable-fact.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.execution-failure-policy.execution-failure-model.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.interaction-authority.interaction-authority-identityseed.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.managed-chat-execution.execution-session-chatexecution-facts.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.participant-identity.participant-persona.fsproj"/>
    <Compile Include="Execution/Session/ChatExecution/Fact.fsi"/>
    <Compile Include="Execution/Session/ChatExecution/Fact.fs"/>
    <Compile Include="Execution/Session/ChatExecution/Recovery.fsi"/>
    <Compile Include="Execution/Session/ChatExecution/Recovery.fs"/>
    <Compile Include="Execution/Session/ChatExecution/RecoveryRuntime.fsi"/>
    <Compile Include="Execution/Session/ChatExecution/RecoveryRuntime.fs"/>
    <Compile Include="Execution/Session/ChatExecution/Admission.fsi"/>
    <Compile Include="Execution/Session/ChatExecution/Admission.fs"/>
  </ItemGroup>
</Project>
