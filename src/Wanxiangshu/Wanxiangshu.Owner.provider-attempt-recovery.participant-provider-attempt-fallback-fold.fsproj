    <Compile Include="Participant/Provider/Attempt/Fallback/ProviderFailureFactFold.fsi"/>
    <Compile Include="Participant/Provider/Attempt/Fallback/ProviderFailureFactFold.fs"/>
    <Compile Include="Participant/Provider/Attempt/Fallback/Evidence.fsi"/>
