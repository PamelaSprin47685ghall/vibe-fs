<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>provider</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>participant-provider-attempt-fallback-fold</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>provider-attempt-recovery</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>participant-provider-attempt-fallback-fold</WanxiangshuOwnerLocality>
