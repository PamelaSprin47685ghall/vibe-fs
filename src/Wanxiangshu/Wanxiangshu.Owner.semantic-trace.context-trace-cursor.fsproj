<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WanxiangshuSubsystem>context</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>context-trace-cursor</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>semantic-trace</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>context-trace-cursor</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Context/Trace/Cursor.fsi"/>
    <Compile Include="Context/Trace/Cursor.fs"/>
  </ItemGroup>
</Project>
