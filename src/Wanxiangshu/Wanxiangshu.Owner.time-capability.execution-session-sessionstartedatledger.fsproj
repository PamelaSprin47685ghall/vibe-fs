<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <WanxiangshuSubsystem>session-lifecycle</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>execution-session-sessionstartedatledger</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>time-capability</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>execution-session-sessionstartedatledger</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-outcome.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.time-capability.execution-session-sessionstartedatprojection.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.time-capability.foundation-temporal-contract.fsproj"/>
    <Compile Include="Execution/Session/SessionStartedAtLedger.fsi"/>
    <Compile Include="Execution/Session/SessionStartedAtLedger.fs"/>
  </ItemGroup>
</Project>
