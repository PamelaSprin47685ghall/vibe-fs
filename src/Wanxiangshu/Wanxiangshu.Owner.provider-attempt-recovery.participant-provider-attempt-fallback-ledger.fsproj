<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <WanxiangshuSubsystem>chat-execution</WanxiangshuSubsystem>
    <WanxiangshuCompileShard>participant-provider-attempt-fallback-ledger</WanxiangshuCompileShard>
    <WanxiangshuSemanticOwner>provider-attempt-recovery</WanxiangshuSemanticOwner>
    <WanxiangshuOwnerLocality>participant-provider-attempt-fallback-ledger</WanxiangshuOwnerLocality>
    <WanxiangshuOwnerLocalityKind>contract</WanxiangshuOwnerLocalityKind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-identity.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.dispatch-protocol.foundation-outcome.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.provider-attempt-recovery.participant-provider-attempt-fallback-facts.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.provider-attempt-recovery.participant-provider-attempt-fallback-fact.fsproj"/>
    <ProjectReference Include="Wanxiangshu.Owner.execution-failure-policy.execution-failure-model.fsproj"/>
    <Compile Include="Participant/Provider/Attempt/Fallback/Ledger.fsi"/>
    <Compile Include="Participant/Provider/Attempt/Fallback/Ledger.fs"/>
  </ItemGroup>
</Project>
